# Base URL of a deployed knowledge-service instance.
# Leave unset in local dev — the Vite proxy forwards /v1/* to
# http://localhost:8090 (see vite.config.ts).
VITE_API_BASE_URL=

# Optional: a knowledge-service API key (KNOWLEDGE_API_KEYS on that service),
# sent as `X-API-Key` on every request. Required once that service has
# KNOWLEDGE_API_KEYS or RAG_AUTH_ENABLED configured — leave unset for a local
# instance with neither set (open/dev mode).
# The stats card (GET /v1/stats) needs a key whose role is "admin"
# (KNOWLEDGE_API_KEYS format: name:key:admin) — a "user"-role key can still
# upload/query/browse files, it just can't see the stats card.
VITE_API_KEY=

# Remember: the target knowledge-service must also set
# KNOWLEDGE_CORS_ORIGINS to include this app's origin (e.g.
# http://localhost:5174) — CORS is off by default (service-to-service only).

# Base URL of a deployed auth-service instance (sign-in/sign-up for this UI).
# Leave unset in local dev — the Vite proxy forwards /auth/* to
# http://localhost:8100 (see vite.config.ts).
# NOTE: this is a SEPARATE identity from VITE_API_KEY above — auth-service's
# JWT authenticates the human into this UI; it is not understood by
# knowledge-service's own auth (different secret/issuer). Requests to
# knowledge-service still go out under VITE_API_KEY.
VITE_AUTH_BASE_URL=

# The target auth-service must also set AUTHSVC_CORS_ORIGINS to include this
# app's origin (e.g. http://localhost:5174) — same default-closed CORS
# policy as knowledge-service.

# ── Which RAG service this console talks to ──────────────────────────────────
#
# The backend is wbg-oissaagent-knowledge (FastAPI, routes under /api/v1).
#
# Local dev: leave VITE_API_BASE_URL empty. The Vite proxy in vite.config.ts
# forwards /api/* to http://localhost:8000 (`make dev` in the RAG repo), so the
# browser stays same-origin and CORS never applies. To proxy to a deployed
# instance instead:
#
#   RAG_PROXY_TARGET=https://<app>.azurewebsites.net
RAG_PROXY_TARGET=

# Deployed: set this to the RAG service's base URL (no trailing slash, no
# /api/v1). The browser then calls it directly, so the RAG service must list
# this app's origin in CORS_ALLOW_ORIGINS. Inlined at BUILD time: on Vercel it
# has to be in the project's environment, not just this file.
VITE_API_BASE_URL=

# ── Authentication ───────────────────────────────────────────────────────────
#
# This console has no user sign-in. What it sends depends on the RAG
# service's AUTH_MODE:
#
#   none     — local dev; leave the key empty. ACLs are not enforced.
#   api_key  — set the same value as the service's API_KEY. It is sent as
#              X-API-Key on every request, and the caller gets
#              API_KEY_PRINCIPALS (default "*": documents shared with
#              everyone). It is baked into the bundle and readable by anyone
#              who can load the page — only use it for internal consoles.
#   entra    — not supported by this console.
VITE_RAG_API_KEY=

# ── Where API calls go ───────────────────────────────────────────────────────
#
# Everything goes through the API gateway, in dev as well as deployed (the same
# as makemerich-frontend). The Vite dev proxy forwards:
#
#   /auth/*  ->  <gateway>/auth/*               (auth-service)
#   /api/*   ->  <gateway>/api/knowledge/api/*  (knowledge-service)
#
# Deployed, vercel.json does the same. There is deliberately no variable that
# puts a gateway or service URL in the bundle.
#
# Dev-server only (never reaches the bundle). Default http://localhost:8000.
GATEWAY_PROXY_TARGET=

# ── Authentication ───────────────────────────────────────────────────────────
#
# The auth-service app account this console signs users in under, the way
# makemerich-frontend uses REACT_APP_MAKEMERICH_ACCOUNT_ID. Sent as account_id
# on login, register and forgot-password; new users are created in it. Copy the
# account_id from the account-management console. Required: the app refuses to
# start without it. Inlined at BUILD time: on Vercel it has to be in the
# project's environment, not just this file.
VITE_KNOWLEDGE_ACCOUNT_ID=
